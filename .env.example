# Chaves da API Omie (Obtenha no painel da Omie)
OMIE_APP_KEY=
OMIE_APP_SECRET=

# URL de conexão com o PostgreSQL
# Exemplo local: postgresql://usuario:senha@localhost:5432/nome_do_banco
# Para produção/nuvem: Use a URL fornecida pelo seu provedor (Supabase, Render, Google Cloud SQL, etc.)
DATABASE_URL=postgresql://admin:admin@localhost:5432/integraomie
