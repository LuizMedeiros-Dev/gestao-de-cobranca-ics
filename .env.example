# Conexão com o Banco de Dados PostgreSQL (Obrigatório)
# Formato: postgresql://<usuario>:<senha>@<host>:<porta>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cobranca

# Chaves de Integração Omie por Empresa (Preencha as que for utilizar)
ICS_OMIE_APP_KEY=
ICS_OMIE_APP_SECRET=

AUTHEN_OMIE_APP_KEY=
AUTHEN_OMIE_APP_SECRET=

TARGET_OMIE_APP_KEY=
TARGET_OMIE_APP_SECRET=

# Configurações de Envio de E-mail via SMTP (Opcional para testes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Configurações do WhatsApp (Evolution API - Opcional para testes)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Segredo JWT para autenticação (Opcional, possui valor default no código)
JWT_SECRET=sua_chave_secreta_jwt
